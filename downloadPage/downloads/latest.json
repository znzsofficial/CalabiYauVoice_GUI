    "changelog": [
        "\u65b0\u589e\u5f26\u6eaf\u6218\u7ebf\u6a21\u5f0f\u7b80\u4ecb\u4e0e\u7ef4\u91cc\u6602\u88c2\u9699\u539f\u751f\u5730\u56fe\uff1b\u6218\u5229\u54c1\u3001\u914d\u4ef6\u3001\u6389\u843d\u4e09\u4e2a\u56fe\u9274\u6536\u5f55\u5230\u201c\u5916\u89c2\u4e0e\u56fe\u9274\u201d\uff0c\u652f\u6301\u641c\u7d22\u3001\u7b5b\u9009\u53ca\u4e13\u7528\u9aa8\u67b6\u5c4f",
        "\u6218\u672f\u9053\u5177\u8be6\u60c5\u65b0\u589e\u9053\u5177\u6548\u679c\uff0c\u8865\u5145\u96ea\u7403\u5206\u6bb5\u84c4\u529b\u4f24\u5bb3\u3001\u711a\u7130\u8005\u4f24\u5bb3\u8bf4\u660e\u548c\u9759\u98ce\u5206\u6a21\u5f0f\u7206\u70b8\u7bad\u6570\u636e",
        "\u6b66\u5668\u8be6\u60c5\u8865\u5145\u6362\u5f39\u3001\u6563\u5e03\u3001\u540e\u5750\u529b\u7b49\u6298\u53e0\u53c2\u8003\u53c2\u6570\u5e76\u4fdd\u7559 Wiki \u6765\u6e90\u63d0\u793a\uff1b\u8865\u9f50\u84c4\u529b\u76f8\u5173\u6570\u503c\uff0cPC \u4e0e\u79fb\u52a8\u7aef\u4f24\u5bb3\u500d\u7387\u5206\u5f00\u5c55\u793a",
        "\u751f\u5316\u5361\u7ec4\u9875\u8865\u9f50\u76d7\u53d6\u7b49\u9057\u6f0f\u5361\u724c\uff0c\u4e25\u683c\u6821\u9a8c\u5206\u4eab\u7801\uff0c\u65e0\u7801\u6761\u76ee\u9690\u85cf\u590d\u5236\u5165\u53e3\uff1bWiki \u5c1a\u65e0\u7d22\u5f15\u7684\u5361\u724c\u9700\u786e\u8ba4\u4ec5\u53d1\u5e03\u5361\u724c\u5217\u8868\uff0c\u6682\u4e0d\u80fd\u751f\u6210\u6e38\u620f\u5bfc\u5165\u7801",
        "\u5e73\u8861\u6570\u636e\u7b5b\u9009\u5728\u65cb\u8f6c\u548c\u5237\u65b0\u540e\u4fdd\u7559\u6709\u6548\u6761\u4ef6\uff0c\u5f39\u5c42\u4fee\u6539\u540e\u7edf\u4e00\u5e94\u7528\uff0c\u53d6\u6d88\u4e0d\u751f\u6548\uff0c\u907f\u514d\u591a\u9009\u65f6\u53cd\u590d\u67e5\u8be2",
        "\u7cbe\u7b80\u9996\u9875\u63d0\u793a\u6587\u6848\uff0c\u6539\u8fdb\u4e3b\u5bfc\u822a\u72b6\u6001\u6062\u590d\u4e0e\u5bbd\u7a84\u5c4f\u5207\u6362\uff0c\u51cf\u5c11\u666e\u901a\u5207\u9875\u52a8\u753b\u3001\u540e\u53f0\u8f6e\u8be2\u53ca\u5c4f\u5916\u7acb\u7ed8\u9884\u53d6\u5f00\u9500",
        "\u5173\u4e8e\u9875\u52a0\u5f3a\u6e10\u53d8\u4e0a\u6587\u5b57\u7684\u53ef\u8bfb\u6027\uff0c\u52a8\u6001\u54cd\u5e94\u7cfb\u7edf\u52a8\u753b\u5f00\u5173\uff0c\u9000\u540e\u53f0\u6682\u505c\u80cc\u666f\u52a8\u753b",
        "\u4e0b\u8f7d\u7ad9\u641c\u7d22\u4e3a Wiki \u8bf7\u6c42\u589e\u52a0\u4e32\u884c\u9650\u901f\u4e0e\u98ce\u63a7\u9000\u907f\uff0c\u7f13\u5b58\u547d\u4e2d\u4e0d\u7b49\u5f85\uff0c\u7d22\u5f15\u5237\u65b0\u5931\u8d25\u65f6\u4fdd\u7559\u5df2\u6709\u53f0\u8bcd\u6570\u636e"
    ],
